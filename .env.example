# ============================================
# CONFIGURAÇÃO DO APP PARISH MOBILE
# ============================================

# URL da API do backend
# Em desenvolvimento local: http://localhost:3000/api/v1
# Em desenvolvimento com dispositivo físico: http://SEU_IP:3000/api/v1
# Em produção: https://api.parish.com.br/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Modo Mock (true para usar dados mockados, false para usar API real)
# Útil para desenvolvimento sem backend
EXPO_PUBLIC_USE_MOCK=true
